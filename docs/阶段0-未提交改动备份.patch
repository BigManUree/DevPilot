+.dp-access-name { font-weight: 600; font-size: 12px; flex-shrink: 0; }
+.dp-access-url { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 320px; }
+
+/* ---------- 启动任务后台执行悬浮状态条 ---------- */
+.dp-start-pill { position: fixed; right: 24px; bottom: 24px; z-index: 1100; display: flex; align-items: center; gap: 9px; padding: 10px 16px; border: 1px solid var(--dp-border-strong); border-radius: 999px; background: var(--dp-card); color: var(--dp-text); font-size: 12.5px; box-shadow: 0 8px 24px rgba(15, 23, 42, .16); cursor: pointer; user-select: none; }
+.dp-start-pill:hover { border-color: var(--dp-primary, #2563eb); }
+.dp-start-pill-dot { width: 9px; height: 9px; border-radius: 50%; background: #2563eb; animation: dp-pill-pulse 1.2s ease-in-out infinite; }
+@keyframes dp-pill-pulse { 0%, 100% { opacity: .35; transform: scale(.85); } 50% { opacity: 1; transform: scale(1.1); } }
+html[data-theme='dark'] .dp-start-pill { box-shadow: 0 8px 24px rgba(0, 0, 0, .45); }
+
+
+/* ---------- 项目卡片简介（导入时 Agent 生成） ---------- */
+.dp-project-desc { font-size: 12px; line-height: 1.5; color: var(--dp-text-2, var(--dp-text)); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 2px 0 6px; }
+
+/* ---------- 详情抽屉头部信息卡（路径 + 简介） ---------- */
