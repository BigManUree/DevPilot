+
+/* ---------- 访问地址一行式布局 ---------- */
+.dp-access-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; padding: 10px 14px; border: 1px solid var(--dp-border); border-radius: 9px; background: var(--dp-code-bg); }
